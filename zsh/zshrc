# zmodload zsh/zprof

# Bootstrap: locate the dotfiles before sourcing anything.
if [ ! -d "$HOME/.dotfiles" ] && [ ! -d "/workspaces/.codespaces" ]; then
  echo "ERROR: The dotfiles need to be cloned to ${HOME}/.dotfiles."
  echo "ERROR: If the dotfiles where cloned to a different place, multiple things will break!"
fi

export DOTFILES=$HOME/.dotfiles
if [ -d "/workspaces/.codespaces" ]; then
  # We are running inside a GitHub Codespace. GitHub doesn't clone the dotfiles into ~/.dotfiles.
  export DOTFILES=/workspaces/.codespaces/.persistedshare/dotfiles
fi

# Source environment variables
source $DOTFILES/zsh/env.zsh

# Source ~/.profile if it exists
if [ -f ~/.profile ]; then
    source ~/.profile
fi

# Source zinit zsh plugin manager
source $DOTFILES/.zinit/zinit.zsh

# Source config
source $DOTFILES/zsh/config.zsh

# Completions
fpath=(/opt/homebrew/share/zsh/site-functions /home/linuxbrew/.linuxbrew/share/zsh/site-functions $fpath)
autoload -Uz compinit
# Rebuild the completion dump at most once a day; load the cache (-C) otherwise.
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then compinit; else compinit -C; fi
if [[ ! ~/.zcompdump.zwc -nt ~/.zcompdump ]]; then
  zcompile ~/.zcompdump &!
fi

# Source key-bindings & completions
source $DOTFILES/zsh/completions.zsh

# Source secrets if the file exists
if [ -f "$DOTFILES/zsh/secrets.zsh" ]; then
  source "$DOTFILES/zsh/secrets.zsh"
fi

# Source aliases
for file in $DOTFILES/**/aliases.zsh; do
  source "$file"
done

# Plugins
zinit for \
  zsh-users/zsh-autosuggestions \
  zdharma/fast-syntax-highlighting \
  fribmendes/geometry \
  chrissicool/zsh-256color \

# fnm — fast node version manager; --use-on-cd honors .nvmrc/.node-version on cd
command -v fnm >/dev/null && eval "$(fnm env --use-on-cd)"

export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# zprof
